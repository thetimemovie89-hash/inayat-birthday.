
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#180e2c">
<title>Миссия: Инаят 💜</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap');

*{box-sizing:border-box}
body{
 margin:0;min-height:100vh;color:white;
 font-family:Nunito,sans-serif;
 background:
 radial-gradient(circle at 15% 10%,#633c94,transparent 38%),
 radial-gradient(circle at 90% 85%,#783c86,transparent 35%),
 #180e2c;
 overflow-x:hidden
}
.container{width:min(92%,620px);margin:auto;padding:30px 0 60px}
header{text-align:center;margin-bottom:24px}
.logo{letter-spacing:4px;font-size:12px;color:#e9caff;font-weight:900}
h1{font-size:clamp(35px,9vw,55px);line-height:1.1;margin:12px 0}
.gradient{
 background:linear-gradient(90deg,#d8b4fe,#f9a8d4);
 -webkit-background-clip:text;background-clip:text;color:transparent
}
.subtitle{color:#ddcfea}
.card{
 background:rgba(255,255,255,.09);
 border:1px solid rgba(255,255,255,.16);
 border-radius:25px;padding:25px;
 box-shadow:0 15px 50px #0003;
 backdrop-filter:blur(14px)
}
.center{text-align:center}
.emoji{font-size:65px;margin:8px}
h2{font-size:25px;margin:10px 0}
p{line-height:1.65;color:#e6d9ef}
button{font-family:inherit;cursor:pointer}
.primary{
 width:100%;border:0;border-radius:16px;padding:16px;
 color:#28123c;font-size:16px;font-weight:900;
 background:linear-gradient(100deg,#d8b4fe,#f0abfc);
 transition:.2s
}
.primary:active{transform:scale(.98)}
.hidden{display:none!important}
.progress-info{
 display:flex;justify-content:space-between;
 color:#e5d4f7;font-size:13px;font-weight:800;margin-bottom:9px
}
.progress{
 height:9px;background:#ffffff20;border-radius:20px;
 overflow:hidden;margin-bottom:25px
}
.progress-fill{
 height:100%;width:0%;
 background:linear-gradient(90deg,#c4b5fd,#f0abfc);
 transition:.3s
}
.question-number{
 color:#d8b4fe;font-size:12px;font-weight:900;letter-spacing:2px
}
.question{font-size:23px;font-weight:900;line-height:1.4;margin:17px 0 23px}
.answers{display:grid;gap:11px}
.answer{
 width:100%;padding:15px;text-align:left;
 border:1px solid #ffffff30;border-radius:15px;
 background:#ffffff0d;color:white;font-size:15px;font-weight:800;
 transition:.2s
}
.answer:hover{background:#c4b5fd25;border-color:#d8b4fe}
.answer:disabled{opacity:.8;cursor:default}
.feedback{
 margin-top:18px;padding:14px;border-radius:14px;
 font-weight:900;text-align:center
}
.correct{background:#4ade8020;color:#bbf7d0}
.wrong{background:#f8717120;color:#fecaca}
.next{margin-top:15px}
.small{font-size:12px;color:#c4b5d3}
.friend-message{
 background:#ffffff0d;border:1px solid #ffffff20;
 border-radius:17px;padding:17px;margin:12px 0;text-align:left
}
.friend-message strong{color:#e9c5ff}
.heart{font-size:75px;animation:pulse 1.5s infinite}
@keyframes pulse{50%{transform:scale(1.13)}}
.confetti{
 position:fixed;top:-25px;font-size:22px;
 animation:fall 4s linear forwards;pointer-events:none;z-index:5
}
@keyframes fall{to{transform:translateY(110vh) rotate(700deg);opacity:0}}
.footer{text-align:center;color:#c4b5d3;font-size:12px;margin-top:25px}
</style>
</head>

<body>
<main class="container">

<header>
 <div class="logo">A SPECIAL MISSION FOR INAYAT</div>
 <h1>Миссия <span class="gradient">Инаят 💜</span></h1>
 <div class="subtitle">Сможешь пройти все испытания?</div>
</header>

<!-- СТАРТ -->
<section id="start" class="card center">
 <div class="emoji">💜🎀</div>
 <h2>Добро пожаловать!</h2>
 <p>
  Для тебя подготовлена секретная миссия.
  Тебя ждут вопросы о BTS, загадки и неожиданные задания.
 </p>
 <p><b>10 основных вопросов + 1 особенный вопрос.</b></p>
 <p>Но будь внимательна: одна ошибка — и придётся начать заново!</p>
 <button class="primary" onclick="startGame()">НАЧАТЬ МИССИЮ ✨</button>
</section>

<!-- ИГРА -->
<section id="quiz" class="card hidden">
 <div class="progress-info">
  <span id="progressText">Вопрос 1 из 10</span>
  <span id="attemptText">Попытка 1</span>
 </div>
 <div class="progress"><div class="progress-fill" id="progressFill"></div></div>
 <div class="question-number" id="questionNumber"></div>
 <div class="question" id="questionText"></div>
 <div class="answers" id="answers"></div>
 <div id="feedback" class="feedback hidden"></div>
 <button id="nextButton" class="primary next hidden" onclick="nextQuestion()">ДАЛЬШЕ →</button>
</section>

<!-- ПРОИГРЫШ -->
<section id="failed" class="card center hidden">
 <div class="emoji">🥺💔</div>
 <h2>Миссия провалена!</h2>
 <p>Одна ошибка — и испытание начинается заново.</p>
 <p>Но теперь тебя ждут другие вопросы. Не сдавайся!</p>
 <button class="primary" onclick="startGame()">НОВАЯ ПОПЫТКА 🔄</button>
</section>

<!-- СПЕЦИАЛЬНЫЙ ВОПРОС -->
<section id="special" class="card center hidden">
 <div class="emoji">🎀💗</div>
 <div class="question-number">ПОСЛЕДНЕЕ ЗАДАНИЕ</div>
 <h2>Самый важный вопрос...</h2>
 <div class="question">
 Кто самая лучшая, добрая, красивая, офигенная и замечательная девочка?
 </div>
 <div class="answers" id="specialAnswers"></div>
 <div id="specialFeedback" class="feedback hidden"></div>
 <button id="specialNext" class="primary next hidden" onclick="finishGame()">ЗАВЕРШИТЬ МИССИЮ 💜</button>
</section>

<!-- ПОЗДРАВЛЕНИЕ -->
<section id="birthday" class="card center hidden">
 <div class="heart">💜</div>
 <div class="logo">MISSION COMPLETED</div>
 <h1>С ДНЁМ РОЖДЕНИЯ, <span class="gradient">ИНАЯТ!</span></h1>
 <p>
 Ты прошла все испытания! А теперь самое главное —
 поздравления от людей, которые хотят сделать твой день особенным.
 </p>

 <!-- ЗАМЕНИТЕ ТЕКСТЫ НА НАСТОЯЩИЕ ПОЗДРАВЛЕНИЯ -->
 <div class="friend-message">
  <strong>💌 От друга №1</strong>
  <p>С днём рождения! Желаю тебе счастья, здоровья, улыбок и исполнения всех желаний!</p>
 </div>

 <div class="friend-message">
  <strong>💌 От друга №2</strong>
  <p>Оставайся такой же доброй и замечательной. Пусть каждый день приносит тебе радость!</p>
 </div>

 <div class="friend-message">
  <strong>💌 От друга №3</strong>
  <p>Пусть рядом всегда будут хорошие люди, а впереди ждёт много счастливых моментов!</p>
 </div>

 <div class="friend-message">
  <strong>💜 От всех друзей</strong>
  <p>
   Инаят, с днём рождения! Мы желаем тебе огромного счастья,
   исполнения мечт, много улыбок и незабываемых впечатлений.
   Спасибо, что ты есть! 💗
  </p>
 </div>

 <div class="emoji">🎂🎁🎉</div>
 <h2>Ты заслуживаешь самого лучшего!</h2>
 <p>С любовью, твои друзья 💜</p>

 <button class="primary" onclick="location.reload()">ПРОЙТИ ЕЩЁ РАЗ 🔄</button>
</section>

<div class="footer">Made with love 💜 Especially for Inayat</div>
</main>

<script>
const questions = [
 {
  q:"В каком году BTS официально дебютировали?",
  a:["2010","2013","2015","2017"],c:1
 },
 {
  q:"Как называется официальный фандом BTS?",
  a:["BLINK","ARMY","ONCE","MOA"],c:1
 },
 {
  q:"Сколько участников в BTS?",
  a:["5","6","7","8"],c:2
 },
 {
  q:"Кто является лидером BTS?",
  a:["Jimin","Jungkook","RM","V"],c:2
 },
 {
  q:"Как называется дебютный сингл-альбом BTS?",
  a:["2 Cool 4 Skool","Wings","Love Yourself","BE"],c:0
 },
 {
  q:"Как зовут самого младшего участника BTS?",
  a:["Jin","Jungkook","Suga","J-Hope"],c:1
 },
 {
  q:"Какой участник BTS известен под сценическим именем V?",
  a:["Kim Taehyung","Kim Namjoon","Park Jimin","Min Yoongi"],c:0
 },
 {
  q:"Как называется песня BTS, выпущенная в 2020 году и ставшая их первым англоязычным синглом?",
  a:["Butter","Dynamite","Spring Day","Life Goes On"],c:1
 },
 {
  q:"Как зовут участника BTS, известного как SUGA?",
  a:["Jung Hoseok","Min Yoongi","Kim Seokjin","Jeon Jungkook"],c:1
 },
 {
  q:"Как называется альбом BTS, выпущенный в 2020 году?",
  a:["Map of the Soul: 7","BE","Wings","Dark & Wild"],c:1
 },
 {
  q:"Какой цвет чаще всего ассоциируется с BTS и ARMY?",
  a:["Фиолетовый","Зелёный","Оранжевый","Жёлтый"],c:0
 },
 {
  q:"Какая кола лучше?",
  a:["С сахаром","Без сахара"],c:1
 },
 {
  q:"Как называется песня BTS с фразой «You can't stop me lovin' myself»?",
  a:["IDOL","DNA","Boy With Luv","Fake Love"],c:0
 },
 {
  q:"Какой участник BTS известен как J-Hope?",
  a:["Jung Hoseok","Kim Taehyung","Park Jimin","Kim Namjoon"],c:0
 },
 {
  q:"Как называется сольная песня Jungkook, выпущенная в 2023 году?",
  a:["Seven","Like Crazy","Daechwita","The Astronaut"],c:0
 },
 {
  q:"Как называется альбом BTS, в который входит песня Spring Day?",
  a:["You Never Walk Alone","BE","Wings","Proof"],c:0
 },
 {
  q:"Кто из участников BTS известен как Worldwide Handsome?",
  a:["Jin","RM","SUGA","J-Hope"],c:0
 },
 {
  q:"Как называется песня BTS с участием Halsey?",
  a:["Butter","Boy With Luv","Dynamite","Run"],c:1
 },
 {
  q:"Какой участник BTS выпустил альбом Indigo?",
  a:["Jimin","Jin","RM","V"],c:2
 },
 {
  q:"В каком году вышла песня Butter?",
  a:["2019","2020","2021","2022"],c:2
 }
];

const specialOptions = [
 "Инаят 💜",
 "Конечно же, Инаят 💗",
 "Только Инаят 🎀",
 "А кто ещё, если не Инаят? ✨",
 "Все варианты правильные 💜"
];

let currentQuestions = [];
let current = 0;
let attempts = 0;
let selected = false;

function shuffle(arr){
 const copy = [...arr];
 for(let i=copy.length-1;i>0;i--){
  const j=Math.floor(Math.random()*(i+1));
  [copy[i],copy[j]]=[copy[j],copy[i]];
 }
 return copy;
}

function show(id){
 ["start","quiz","failed","special","birthday"].forEach(x=>{
  document.getElementById(x).classList.toggle("hidden",x!==id);
 });
 window.scrollTo({top:0,behavior:"smooth"});
}

function startGame(){
 attempts++;
 current=0;
 selected=false;
 currentQuestions=shuffle(questions).slice(0,10);
 document.getElementById("attemptText").textContent="Попытка "+attempts;
 show("quiz");
 renderQuestion();
}

function renderQuestion(){
 selected=false;
 const item=currentQuestions[current];
 document.getElementById("progressText").textContent="Вопрос "+(current+1)+" из 10";
 document.getElementById("progressFill").style.width=(current/10*100)+"%";
 document.getElementById("questionNumber").textContent="Задание "+(current+1);
 document.getElementById("questionText").textContent=item.q;
 document.getElementById("feedback").className="feedback hidden";
 document.getElementById("nextButton").classList.add("hidden");

 const box=document.getElementById("answers");
 box.innerHTML="";

 let options=item.a.map((text,index)=>({text,correct:index===item.c}));
 options=shuffle(options);

 options.forEach(option=>{
  const button=document.createElement("button");
  button.className="answer";
  button.textContent=option.text;
  button.onclick=()=>answerQuestion(button,option.correct);
  box.appendChild(button);
 });
}

function answerQuestion(button,correct){
 if(selected)return;
 selected=true;

 document.querySelectorAll("#answers button").forEach(b=>b.disabled=true);

 const feedback=document.getElementById("feedback");
 feedback.classList.remove("hidden");

 if(correct){
  button.style.borderColor="#86efac";
  button.style.background="#4ade8025";
  feedback.className="feedback correct";
  feedback.textContent="Правильно! Отличная работа 💜";
  document.getElementById("nextButton").classList.remove("hidden");
 }else{
  button.style.borderColor="#fca5a5";
  button.style.background="#f8717125";
  feedback.className="feedback wrong";
  feedback.textContent="Неправильный ответ! Попробуй ещё раз в новой миссии.";
  setTimeout(()=>show("failed"),1200);
 }
}

function nextQuestion(){
 current++;
 if(current<10){
  renderQuestion();
 }else{
  document.getElementById("progressFill").style.width="100%";
  showSpecial();
 }
}

function showSpecial(){
 show("special");
 const box=document.getElementById("specialAnswers");
 box.innerHTML="";
 document.getElementById("specialFeedback").classList.add("hidden");
 document.getElementById("specialNext").classList.add("hidden");

 shuffle(specialOptions).forEach(option=>{
  const button=document.createElement("button");
  button.className="answer";
  button.textContent=option;
  button.onclick=()=>{
   if(selected)return;
   selected=true;
   document.querySelectorAll("#specialAnswers button").forEach(b=>b.disabled=true);
   button.style.borderColor="#86efac";
   button.style.background="#4ade8025";
   const feedback=document.getElementById("specialFeedback");
   feedback.className="feedback correct";
   feedback.textContent="Абсолютно правильно! Все ответы верные! 💜";
   document.getElementById("specialNext").classList.remove("hidden");
  };
  box.appendChild(button);
 });
 selected=false;
}

function finishGame(){
 show("birthday");
 confetti();
}

function confetti(){
 const symbols=["💜","💗","✨","🎀","💖","🌸","⭐"];
 for(let i=0;i<65;i++){
  const el=document.createElement("div");
  el.className="confetti";
  el.textContent=symbols[Math.floor(Math.random()*symbols.length)];
  el.style.left=Math.random()*100+"vw";
  el.style.animationDelay=Math.random()*2+"s";
  el.style.fontSize=(15+Math.random()*18)+"px";
  document.body.appendChild(el);
  setTimeout(()=>el.remove(),6500);
 }
}
</script>
</body>
</html>
